# Neon Postgres connection string (required for case studies + site content)
# Create a project at https://neon.tech or use the Vercel Neon integration.
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Analytics 4 measurement ID (optional override; defaults to G-HHTFX21LZ7)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HHTFX21LZ7

# Google Search Console site verification (optional override)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=RsJWqjpnVMIU3SqHpcB0q1hBtYQMJ8-4hKhd0ipmfjU

# Microsoft Clarity project ID (optional override; defaults to xf702razyv)
NEXT_PUBLIC_CLARITY_PROJECT_ID=xf702razyv

# Tawk.to live chat widget (property ID + widget ID from the Tawk.to dashboard)
NEXT_PUBLIC_TAWK_PROPERTY_ID=6a4ec23ea6558f1d451fd6b5
NEXT_PUBLIC_TAWK_WIDGET_ID=1jt1qdhan
